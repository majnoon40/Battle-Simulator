# Build directories
build/
build-*/

# Local artifacts (exports, timelines, reports, replays, renders)
output/
download/
logs/
*.replay

# Editors / OS
.vscode/
.idea/
.DS_Store

# Python (tools/mapgen)
__pycache__/
*.pyc
